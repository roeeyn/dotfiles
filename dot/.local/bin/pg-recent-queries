#!/usr/bin/env python3
r"""Print recent psql queries for pg-nvim's `\e` history block.

pg-nvim appends this output below a scissors line in the psql edit buffer so you
can recall and copy prior queries; the block is stripped before the buffer is
saved (and re-run) by psql.

macOS psql (18.x) links libedit, so ~/.psql_history is in libedit's
`_HiStOrY_V2_` format: one entry per physical line, with special bytes
octal-escaped as \ooo (\040 = space, \134 = backslash, \012 = newline). This
decodes that format, dedupes globally, and prints the newest N distinct entries
(newest first), each as a numbered SQL block.

Note: a GNU readline build (typical on Linux) uses a different on-disk format;
this parser targets the libedit format found on macOS.
"""

import sys
from pathlib import Path

HISTORY = Path.home() / ".psql_history"
NUM_QUERIES = 20


def decode_entry(raw: bytes) -> str:
    """Decode one libedit history line: \\ooo octal escapes -> raw bytes."""
    out = bytearray()
    i = 0
    n = len(raw)
    while i < n:
        if (
            raw[i] == 0x5C  # backslash
            and i + 4 <= n
            and all(0x30 <= raw[j] <= 0x37 for j in range(i + 1, i + 4))
        ):
            out.append(int(raw[i + 1 : i + 4], 8))
            i += 4
        else:
            out.append(raw[i])
            i += 1
    return out.decode("utf-8", "replace")


def main() -> None:
    try:
        data = HISTORY.read_bytes()
    except OSError:
        sys.exit(0)

    seen: set[str] = set()
    queries: list[str] = []
    # Newest entries are appended at the end of the file; walk backwards.
    for raw in reversed(data.split(b"\n")):
        if not raw or raw.startswith(b"_HiStOrY"):
            continue
        entry = decode_entry(raw).strip()
        if not entry or entry in seen:
            continue
        seen.add(entry)
        queries.append(entry)
        if len(queries) >= NUM_QUERIES:
            break

    if not queries:
        sys.exit(0)

    blocks = [f"-- [{idx}]\n{q}" for idx, q in enumerate(queries, start=1)]
    print("\n\n".join(blocks))


if __name__ == "__main__":
    main()
