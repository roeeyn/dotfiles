# Template for dot/env/.env — the machine-local secrets file, sourced by
# .zshrc and NEVER tracked (gitignored). script/setup copies this template
# into place on first run; fill in real values per machine.
export CONTEXT7_API_KEY="ctx7sk-REPLACE_ME"
export ATLASSIAN_API_KEY="REPLACE_ME"
export ATLASSIAN_URL="REPLACE_ME"
export ATLASSIAN_USERNAME="REPLACE_ME"
export BITBUCKET_API_KEY="REPLACE_ME"
export JENKINS_USER="REPLACE_ME"
export JENKINS_TOKEN="REPLACE_ME"
# wakatime-cli also reads ~/.wakatime.cfg; this env var takes precedence
export WAKATIME_API_KEY="waka_REPLACE_ME"
