#!/usr/bin/env python3
"""Extract recent opencode assistant messages for the slim-nvim prompt editor.

Mirrors `claude-last-response` but reads opencode's SQLite database
(`~/.local/share/opencode/opencode.db`). Schema (opencode 1.14+):
- session(id, directory, time_updated, ...)            -- worktree maps via `directory`
- message(id, session_id, time_created, data JSON)     -- role is in `data.role`
- part(id, message_id, time_created, data JSON)        -- text is in `data.text` for type=text

Session lookup: cwd → most recently updated session whose `directory` matches.
"""

import json
import os
import sqlite3
import sys
from pathlib import Path

NUM_RESPONSES = 3
DB_PATH = Path.home() / ".local" / "share" / "opencode" / "opencode.db"


def find_session(conn: sqlite3.Connection, cwd: str) -> str | None:
    """Most recently updated opencode session for the given worktree.
    Falls back to the symlink-resolved cwd if the literal path matches nothing,
    since opencode persists whatever path it was started with."""
    for candidate in (cwd, str(Path(cwd).resolve())):
        row = conn.execute(
            "SELECT id FROM session WHERE directory = ? "
            "ORDER BY time_updated DESC LIMIT 1",
            (candidate,),
        ).fetchone()
        if row:
            return row[0]
    return None


def extract_responses(conn: sqlite3.Connection, session_id: str) -> list[str]:
    """Last N assistant text responses, newest-first."""
    msg_rows = conn.execute(
        "SELECT id FROM message "
        "WHERE session_id = ? "
        "AND json_extract(data, '$.role') = 'assistant' "
        "ORDER BY time_created DESC LIMIT ?",
        (session_id, NUM_RESPONSES),
    ).fetchall()

    responses: list[str] = []
    for (msg_id,) in msg_rows:
        parts = conn.execute(
            "SELECT json_extract(data, '$.text') FROM part "
            "WHERE message_id = ? "
            "AND json_extract(data, '$.type') = 'text' "
            "ORDER BY time_created ASC",
            (msg_id,),
        ).fetchall()
        text = "\n\n".join(p[0] for p in parts if p[0])
        if text:
            responses.append(text)

    return responses


def main():
    if not DB_PATH.is_file():
        sys.exit(0)

    cwd = os.environ.get("SLIM_NVIM_CWD", os.getcwd())

    # Open read-only — never block opencode if it has the DB locked for writes.
    conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=2.0)
    try:
        session_id = find_session(conn, cwd)
        if not session_id:
            sys.exit(0)
        responses = extract_responses(conn, session_id)
    finally:
        conn.close()

    if responses:
        # Same separator as claude-last-response so the editor experience is
        # identical regardless of which agent launched the prompt.
        separator = "\n\n---\n=== PREVIOUS MESSAGE vvv ===\n---\n\n"
        print(separator.join(responses))


if __name__ == "__main__":
    main()
