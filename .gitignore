# Macos files
.DS_Store

# Firebase files
logs/
firebase-tools.json
update-notifier-firebase-tools.json

# Copilot configuration
github-copilot/

# SSH files
id_ed25519
id_ed25519.pub
id_rsa
id_rsa.pub
known_hosts
known_hosts.old

# dot/.ssh/ — only the config file is tracked; everything else (keys, agent socks, known_hosts) stays out
dot/.ssh/*
!dot/.ssh/config

# dot/.claude/ — only the statusline script is shared. Everything else Claude
# Code keeps in ~/.claude is machine-local and large (plugins/, projects/,
# security/, session state), and settings.json must stay unstowed: the
# statusline-watcher installer rewrites it with `> tmp && mv`, which would
# replace a stow symlink with a real file on every skill update.
dot/.claude/*
!dot/.claude/statusline-command.sh

