// Tokyonight (storm) theme for Zellij — palette pulled verbatim from
// folke/tokyonight.nvim (lua/tokyonight/colors/storm.lua).
// Signature accent is `blue` #7aa2f7 (122 162 247), matching the tmux-power
// accent in ~/.tmux.conf so the active mode ribbon + focused pane border
// read the same across nvim, tmux, and zellij.
//
// Storm palette reference (hex -> rgb):
//   bg           #24283b  36 40 59      fg         #c0caf5  192 202 245
//   bg_dark      #1f2335  31 35 53      fg_gutter  #3b4261  59 66 97
//   bg_highlight #292e42  41 46 66      comment    #565f89  86 95 137
//   blue         #7aa2f7  122 162 247   cyan       #7dcfff  125 207 255
//   green        #9ece6a  158 206 106   magenta    #bb9af7  187 154 247
//   orange       #ff9e64  255 158 100   red        #f7768e  247 118 142
//   yellow       #e0af68  224 175 104   purple     #9d7cd8  157 124 216
themes {
    tokyonight-storm {
        text_unselected {
            base 192 202 245
            background 36 40 59
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        text_selected {
            base 192 202 245
            background 41 46 66
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        ribbon_unselected {
            base 192 202 245
            background 59 66 97
            emphasis_0 247 118 142
            emphasis_1 255 158 100
            emphasis_2 122 162 247
            emphasis_3 187 154 247
        }
        ribbon_selected {
            base 31 35 53
            background 122 162 247
            emphasis_0 247 118 142
            emphasis_1 255 158 100
            emphasis_2 187 154 247
            emphasis_3 125 207 255
        }
        table_title {
            base 122 162 247
            background 36 40 59
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        table_cell_unselected {
            base 192 202 245
            background 36 40 59
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        table_cell_selected {
            base 192 202 245
            background 41 46 66
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        list_unselected {
            base 192 202 245
            background 36 40 59
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        list_selected {
            base 192 202 245
            background 41 46 66
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        frame_unselected {
            base 86 95 137
            background 36 40 59
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        frame_selected {
            base 122 162 247
            background 36 40 59
            emphasis_0 125 207 255
            emphasis_1 187 154 247
            emphasis_2 255 158 100
            emphasis_3 158 206 106
        }
        frame_highlight {
            base 255 158 100
            background 36 40 59
            emphasis_0 187 154 247
            emphasis_1 157 124 216
            emphasis_2 158 206 106
            emphasis_3 224 175 104
        }
        exit_code_success {
            base 158 206 106
            background 36 40 59
            emphasis_0 125 207 255
            emphasis_1 158 206 106
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        exit_code_error {
            base 247 118 142
            background 36 40 59
            emphasis_0 224 175 104
            emphasis_1 247 118 142
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        multiplayer_user_colors {
            player_1 187 154 247
            player_2 122 162 247
            player_3 158 206 106
            player_4 255 158 100
            player_5 125 207 255
            player_6 247 118 142
            player_7 224 175 104
            player_8 157 124 216
            player_9 115 122 162
            player_10 86 95 137
        }
    }
}
