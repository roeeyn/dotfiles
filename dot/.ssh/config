Host bitbucket.org
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

Host github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/id_ed25519_github_emu
  IdentitiesOnly yes

# Personal GitHub (e.g. .dotfiles) — use via remote URL git@github-personal:user/repo.git
Host github-personal
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
