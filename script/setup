#!/bin/bash
set -e

cd "$(dirname "$0")/.."

PROFILE_FILE="$HOME/.dotfiles-profile"
# Cloned via the github-personal ssh alias from the SHARED ssh config:
# the work machine's github.com host uses the EMU key, which cannot
# access personal private repos.
WORK_OVERLAY_REPO="git@github-personal:roeeyn/dotfiles-work.git"

# ----------------------------------------------------------------------
# Profile preflight — RESOLVES the profile and prints its name on stdout.
# Its stdout is the value channel (captured below), so it prints nothing
# else; the main flow reports failures on stdout, where Strap shows them
# (Strap discards stderr unless STRAP_DEBUG is set). Persistence and
# switch cleanup are handled by the main flow too; this function only
# decides.
#
# Precedence: CLI arg > $DOTFILES_PROFILE env > $PROFILE_FILE marker
# > default "personal". The marker MUST outrank the default: Strap
# re-runs this script bare, and a work machine must not silently fall
# back to personal. Valid profiles are the folders in profiles/, plus
# "work", which is valid even before the private overlay is cloned.
select_profile() {
  local profile
  profile="${1:-${DOTFILES_PROFILE:-}}"
  if [ -z "$profile" ] && [ -f "$PROFILE_FILE" ]; then
    profile="$(cat "$PROFILE_FILE")"
  fi
  profile="${profile:-personal}"

  case "$profile" in */* | .*) return 1 ;; esac
  if [ "$profile" = "work" ] || [ -d "profiles/$profile" ]; then
    echo "$profile"
    return 0
  fi
  return 1
}

command -v stow >/dev/null || brew install stow

PREV_PROFILE="$(cat "$PROFILE_FILE" 2>/dev/null || true)"
if ! PROFILE="$(select_profile "$@")"; then
  echo "Unknown profile '${1:-${DOTFILES_PROFILE:-}}'." \
    "Available: $( (ls profiles/ 2>/dev/null; echo work) | sort -u | tr '\n' ' ')"
  echo "Usage: script/setup [profile]  (or DOTFILES_PROFILE=<profile>)"
  exit 1
fi
echo "Setting up profile: $PROFILE"

# Switching profiles: unstow the old overlay first so none of its links
# leak into the new profile (stow only removes links the package owns).
if [ -n "$PREV_PROFILE" ] && [ "$PREV_PROFILE" != "$PROFILE" ] &&
  [ -d "profiles/$PREV_PROFILE" ]; then
  echo "Profile switch: $PREV_PROFILE -> $PROFILE (unstowing $PREV_PROFILE)"
  stow --delete -d profiles "$PREV_PROFILE" --target="$HOME"
fi
echo "$PROFILE" >"$PROFILE_FILE"

# Adopt pre-existing real files once; never touch our own symlinks.
# ~/.gitconfig matters on fresh machines: Strap writes one (git config
# --global) BEFORE running this script, and stow refuses to link over it.
for f in "$HOME/.zshrc" "$HOME/.ssh/config" "$HOME/.gitconfig"; do
  if [ -f "$f" ] && [ ! -L "$f" ]; then
    mv "$f" "$f.pre-dotfiles"
  fi
done

# Keep lazygit's mutable state outside the stowed config directory.
mkdir -p "$HOME/Library/Application Support/lazygit"

# Real dirs so stow never folds ~/.ssh or ~/.gnupg into the repo
# (ssh-keygen and gpg must not write private keys, keyrings, or sockets
# into the repo tree) and both the dot/ and profile packages can
# coexist inside them. mkdir -p FOLLOWS an existing symlink, so a legacy
# machine where stow already folded these must unfold first — fail loudly
# rather than silently generate keys inside the git checkout.
for d in "$HOME/.ssh" "$HOME/.gnupg"; do
  if [ -L "$d" ]; then
    echo "ERROR: $d is a symlink into the repo (legacy stow folding)."
    echo "Unfold it first: back it up, replace the symlink with a real"
    echo "chmod-700 directory, and move the machine-local files (keys,"
    echo "known_hosts, keyrings) back into it. Then re-run script/setup."
    exit 1
  fi
done
mkdir -p "$HOME/.ssh/config.d" "$HOME/.gnupg"
chmod 700 "$HOME/.ssh" "$HOME/.gnupg"

stow --restow dot/ --target="$HOME"

# Symlink files/* into home directory as regular files
stow --restow files/ --target="$HOME"

# The work overlay lives in a private repo, cloned on demand. Soft-fail:
# a fresh Strap run may predate the machine's SSH keys — shared config
# still applies, and the next `script/setup` picks the overlay up.
if [ "$PROFILE" = "work" ] && [ ! -d "profiles/work/.git" ]; then
  git clone "$WORK_OVERLAY_REPO" profiles/work ||
    echo "WARN: work overlay clone failed (SSH keys?); re-run script/setup later."
elif [ "$PROFILE" = "work" ]; then
  # Keep an existing overlay current — Strap re-runs pull the public repo
  # but nothing else updates the private one.
  git -C profiles/work pull --ff-only ||
    echo "WARN: work overlay pull failed; continuing with the local copy."
fi

if [ -d "profiles/$PROFILE" ]; then
  stow --restow -d profiles "$PROFILE" --target="$HOME"
fi

# Profile-owned provisioning hook (e.g. the work overlay generates and
# registers the EMU key it requires — logic that must not live in this
# public script).
if [ -x "profiles/$PROFILE/hooks/setup" ]; then
  "profiles/$PROFILE/hooks/setup"
fi

# Machine-local secrets: dot/env/.env is sourced by .zshrc and gitignored
# (secrets never enter git). Scaffold it from the template on first run so
# a fresh machine gets an explicit fill-me-in file instead of silent
# missing env vars.
if [ ! -f dot/env/.env ]; then
  cp dot/env/.example.env dot/env/.env
  echo "Created dot/env/.env from the template — fill in the real values."
fi

# ----------------------------------------------------------------------
# Per-machine SSH identity. Keys are generated locally and never enter
# the repo; GitHub holds one auth + one signing pubkey per machine, so a
# lost machine means revoking one key, not rotating a shared one.
# Registration needs an authenticated PERSONAL gh — a fresh Strap run
# won't have it, but strap-after-setup re-runs this script after `brew
# bundle`, and a manual re-run after `gh auth login` also converges.
KEY="$HOME/.ssh/id_ed25519"
if [ ! -f "$KEY" ]; then
  echo "Generating this machine's SSH key..."
  ssh-keygen -t ed25519 -N "" -C "roeeyn@$(hostname -s)" -f "$KEY"
fi
if command -v gh >/dev/null && [ "$(gh api user --jq .login 2>/dev/null)" = "roeeyn" ]; then
  # Auth and signing keys live in separate GitHub registries — check each
  # independently so a partial success (e.g. missing signing scope on the
  # first run) still converges on later runs.
  PUB_MATERIAL="$(awk '{print $2}' "$KEY.pub")"
  if ! gh api user/keys --jq '.[].key' 2>/dev/null | grep -qF "$PUB_MATERIAL"; then
    gh ssh-key add "$KEY.pub" --title "roeeyn@$(hostname -s)" ||
      echo "WARN: auth-key registration failed; add $KEY.pub manually."
  fi
  if ! gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null | grep -qF "$PUB_MATERIAL"; then
    gh ssh-key add "$KEY.pub" --type signing --title "roeeyn@$(hostname -s)" ||
      echo "WARN: signing-key registration failed; add $KEY.pub manually."
  fi
else
  # Work machines run gh as the EMU account — NEVER auto-register there:
  # the key would land on the wrong GitHub account. The commands below
  # must run where gh is authenticated as the PERSONAL account.
  echo "gh is missing or not the personal account."
  echo "Register this key FROM THE PERSONAL account (do NOT run these with a work gh):"
  echo "  gh ssh-key add <file> --title roeeyn@$(hostname -s)"
  echo "  gh ssh-key add <file> --type signing --title roeeyn@$(hostname -s)"
  echo "  (or paste it at https://github.com/settings/keys — auth AND signing)"
  cat "$KEY.pub"
fi
